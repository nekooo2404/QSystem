generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTOR
  MANAGER
  EMPLOYEE
}

enum NotifChannel {
  EMAIL
  VIBER
  SOCKET
}

enum NotifStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

model Department {
  id        String   @id @default(cuid())
  name      String
  managerId String?  @map("manager_id")
  parentId  String?  @map("parent_id")
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  manager  User?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")
  members  User[]       @relation("UserDepartment")
  files    File[]

  @@map("departments")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         Role      @default(EMPLOYEE)
  departmentId String?   @map("department_id")
  reportsToId  String?   @map("reports_to_id")
  tenantId     String?   @map("tenant_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department           Department?           @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  reportsTo            User?                 @relation("UserReports", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports        User[]                @relation("UserReports")
  managedDepartments   Department[]          @relation("DepartmentManager")
  ownedFiles           File[]                @relation("FileOwner")
  sentDelegations      ApprovalDelegation[]  @relation("DelegationFrom")
  receivedDelegations  ApprovalDelegation[]  @relation("DelegationTo")
  auditActions         AuditLog[]            @relation("AuditActor")
  notifications        Notification[]        @relation("NotificationRecipient")
  refreshTokens        RefreshToken[]        @relation("RefreshTokenUser")

  @@map("users")
}

model ApprovalDelegation {
  id           String   @id @default(cuid())
  fromUserId   String   @map("from_user_id")
  toUserId     String   @map("to_user_id")
  startsAt     DateTime @map("starts_at")
  endsAt       DateTime @map("ends_at")
  moduleScope  String?  @map("module_scope")
  tenantId     String?  @map("tenant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  from User @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("approval_delegations")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Notification {
  id            String       @id @default(cuid())
  channel       NotifChannel @default(EMAIL)
  recipient     String
  recipientId   String?      @map("recipient_id")
  payload       Json?
  status        NotifStatus  @default(PENDING)
  attempts      Int          @default(0)
  tenantId      String?      @map("tenant_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  recipientUser User? @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model File {
  id           String    @id @default(cuid())
  bucket       String
  key          String
  ownerId      String    @map("owner_id")
  departmentId String?   @map("department_id")
  size         Int?
  mimeType     String?   @map("mime_type")
  tenantId     String?   @map("tenant_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  owner      User        @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([bucket, key])
  @@map("files")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @unique @map("replaced_by_id")
  tenantId     String?   @map("tenant_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User          @relation("RefreshTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@map("refresh_tokens")
}

/// Shared login rate-limit hits (pre-auth; no RLS, see migration).
model RateLimitHit {
  id     BigInt   @id @default(autoincrement())
  bucket String
  key    String
  at     DateTime @default(now())

  @@index([bucket, key, at])
  @@map("rate_limit_hits")
}
