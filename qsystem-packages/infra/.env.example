# Copy to infra/.env for local dev:
#   cp infra/.env.example infra/.env
# (infra/.env is gitignored by the root `.env` rule — never commit secrets.)

# Optional host-port overrides when the defaults clash with other local stacks:
# POSTGRES_PORT=55432
# REDIS_PORT=6479
# S3_PORT=9000
# S3_CONSOLE_PORT=9001
# MEILI_PORT=7700

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Buiduchoa2445
POSTGRES_DB=qsystem
DATABASE_URL="postgresql://postgres:Buiduchoa2445@localhost:5432/qsystem?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=qsystem

S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=<MAT_KHAU_STORAGE>
S3_FORCE_PATH_STYLE=true

# --- Meilisearch ---
MEILI_MASTER_KEY=change-me-32-chars-minimum-0000
MEILI_URL="http://localhost:7700"

# --- Auth (JWT) ---
# Placeholder only — generate a real secret per environment.
JWT_SECRET=change-me-in-production-use-64-hex-chars

# --- SMTP (Nodemailer; dev: log-file) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QSystem <no-reply@example.com>"

# --- Viber ---
VIBER_AUTH_TOKEN=
VIBER_SENDER_NAME=QSystem
