# Staging environment template (copy out of repo or inject via secret manager)
APP_ENV=staging
NODE_ENV=production
TENANCY_MODE=single-tenant
PORT=3001

# Provide either direct secret env vars via Vault/SSM/K8s or mount *_FILE paths:
DATABASE_URL_FILE=/run/secrets/database_url
RLS_OWNER_URL_FILE=/run/secrets/rls_owner_url
JWT_SECRET_FILE=/run/secrets/jwt_secret

S3_ENDPOINT=https://s3-staging.internal
S3_BUCKET=qsystem-docs
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key

MEILI_URL=https://search-staging.internal
MEILI_MASTER_KEY_FILE=/run/secrets/meili_master_key

REDIS_URL=redis://redis:6379
RATE_LIMIT_STORE=redis

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_PATH=/
CORS_ORIGINS=https://staging.qsystem.internal
BODY_LIMIT=1mb
ENABLED_MODULES=qtask,qhrm,qcrm,qsocial
QSYSTEM_API_URL=http://api:3001
