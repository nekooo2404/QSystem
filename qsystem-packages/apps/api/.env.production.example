# Inject real values through the deployment secret manager. Do not commit secrets.
APP_ENV=production
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public
RLS_OWNER_URL=postgresql://<owner-user>:<owner-password>@<host>:5432/<database>?schema=public
REDIS_URL=redis://<host>:6379
RATE_LIMIT_STORE=redis
JWT_SECRET=<minimum-32-character-random-secret>
S3_ENDPOINT=https://storage.example.com
S3_REGION=us-east-1
S3_BUCKET=qsystem-docs
S3_ACCESS_KEY=<storage-access-key>
S3_SECRET_KEY=<storage-secret-key>
MEILI_URL=https://search.example.com
MEILI_MASTER_KEY=<meilisearch-master-key>
NEXT_PUBLIC_DEMO_MODE=false
